<?xml version="1.0" encoding="utf-8"?>
<!-- Typing dictated text into another app's focused field requires window
     content access; we never observe events, we only act on demand. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewFocused|typeViewTextSelectionChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/dictation_a11y_description"
    android:notificationTimeout="100" />
